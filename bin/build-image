#!/usr/bin/env sh
# Make the kernel runnable. With podman or docker: pull the published image from GHCR (no build on
# your machine; Squero Studio MX then runs it by its pinned digest), or, with SQUERO_KERNEL_BUILD=local
# or when the pull fails, build it here (the context is the folder that holds squero-julia-kernel,
# SqueroBase.jl and SqueroPlot.jl side by side). Without either, with Julia 1.11 on PATH: the native
# project (SQUERO_JULIA=native). `paperboat squero install` runs this.
# SQUERO_KERNEL_RUNTIME=podman|docker|native picks one.
set -eu
TAG=1.11.6-r4
PUBLISHED="ghcr.io/paperboatlab/squero-julia-kernel:$TAG"
IMAGE="${SQUERO_KERNEL_IMAGE:-squero-julia-kernel:$TAG}"
HERE="$(cd "$(dirname "$0")/.." && pwd)"
CONTEXT="$(dirname "$HERE")"
for dep in SqueroBase.jl SqueroPlot.jl; do
  [ -d "$CONTEXT/$dep" ] || { echo "build-image: $CONTEXT/$dep is missing (check it out beside the kernel)" >&2; exit 2; }
done
runtime="${SQUERO_KERNEL_RUNTIME:-}"
if [ -z "$runtime" ]; then
  for r in podman docker julia; do
    if command -v "$r" >/dev/null 2>&1; then runtime=$r; break; fi
  done
fi
case "$runtime" in
  podman|docker)
    if [ "${SQUERO_KERNEL_BUILD:-}" != "local" ] && [ -z "${SQUERO_KERNEL_IMAGE:-}" ]; then
      echo "build-image: pulling $PUBLISHED with $runtime"
      if "$runtime" pull "$PUBLISHED"; then exit 0; fi
      echo "build-image: could not pull $PUBLISHED; building it here instead" >&2
    fi
    echo "build-image: $IMAGE with $runtime"
    exec "$runtime" build -f "$HERE/Dockerfile" -t "$IMAGE" "$CONTEXT" ;;
  julia|native)
    version="$(julia --version 2>/dev/null | sed -n 's/^julia version \([0-9]*\.[0-9]*\).*/\1/p')"
    [ "$version" = "1.11" ] || { echo "build-image: the native kernel needs Julia 1.11 (found ${version:-none}); install it (juliaup add 1.11) or podman" >&2; exit 2; }
    echo "build-image: native project in $HERE"
    exec julia --startup-file=no --project="$HERE" -e 'using Pkg; Pkg.instantiate(); Pkg.precompile()' ;;
  *)
    echo "build-image: install podman or docker (or Julia 1.11 for the native kernel)" >&2
    exit 2 ;;
esac
