#!/usr/bin/env sh
# squero-mx doctor: what starts the kernel, and whether it answers.
set -eu
# The published image (what an install pulls), else a local build of the same tag.
PUBLISHED=ghcr.io/paperboatlab/squero-julia-kernel:1.11.6-r4
IMAGE="${SQUERO_KERNEL_IMAGE:-$PUBLISHED}"
NATIVE="$(command -v julia || true)"
PODMAN="$(command -v podman || true)"
DOCKER="$(command -v docker || true)"
RUNTIME="${SQUERO_JULIA:-}"

if [ -z "$RUNTIME" ]; then
  if [ -n "$PODMAN" ]; then RUNTIME=podman
  elif [ -n "$DOCKER" ]; then RUNTIME=docker
  elif [ -n "$NATIVE" ]; then RUNTIME=native
  fi
fi

echo "squero-julia-kernel"
echo "  runtime: ${RUNTIME:-none}"
[ -n "$NATIVE" ] && echo "  native:  $($NATIVE --version)"
if [ "$RUNTIME" = "podman" ] || [ "$RUNTIME" = "docker" ]; then
  command -v "$RUNTIME" >/dev/null 2>&1 || { echo "  $RUNTIME: not found"; exit 2; }
  if [ -z "${SQUERO_KERNEL_IMAGE:-}" ] && ! "$RUNTIME" image inspect "$IMAGE" >/dev/null 2>&1; then
    IMAGE="squero-julia-kernel:1.11.6-r4"  # a local build (bin/build-image with SQUERO_KERNEL_BUILD=local)
  fi
  "$RUNTIME" image inspect "$IMAGE" >/dev/null 2>&1 || { echo "  image:   $IMAGE (missing: run bin/build-image)"; exit 2; }
  DIGEST="$("$RUNTIME" image inspect "$IMAGE" --format '{{if .RepoDigests}}{{index .RepoDigests 0}}{{else}}{{.Id}}{{end}}' 2>/dev/null || true)"
  echo "  image:   $IMAGE"
  [ -n "$DIGEST" ] && echo "  digest:  $DIGEST"
  printf '%s\n' '{"op":"hello"}' | "$RUNTIME" run --rm -i --network=none -e "SQUERO_KERNEL_IMAGE=$IMAGE" -e "SQUERO_KERNEL_DIGEST=${DIGEST#*@}" "$IMAGE" | sed 's/^/  hello:   /'
elif [ "$RUNTIME" = "native" ]; then
  [ -n "$NATIVE" ] || { echo "  native julia: not found"; exit 2; }
  echo "  image:   native (no container)"
  printf '%s\n' '{"op":"hello"}' | "$NATIVE" --startup-file=no --project="$(dirname "$0")/.." "$(dirname "$0")/../src/kernel.jl" | sed 's/^/  hello:   /'
else
  echo "  install Julia, podman or docker" >&2
  exit 2
fi
